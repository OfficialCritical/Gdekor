@page
@model Gdekor.Pages.G_Oldalak.AlkalmazottakModel
@{
    ViewData["Title"] = "Alkalmazottak";
}
<style>
    .kozepResz{
        background: url(/images/feher_top.webp);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .teloLink{
        text-decoration:none;
        font-style:italic;
        color:black;
        display: inline-block;
        text-wrap: nowrap;
        transition: transform 0.4s ease-out;
    }

    .teloLink:hover{
        transform: scale(1.05);
    }

    .cardTeto{
        display: flex;
        justify-content:space-between;
    }

    .blckBrwn_Grdnt_Font {
        background: linear-gradient(135deg, black 0%, black 17.5%, #5c3a28);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
        width: fit-content;
    }

    th {
        padding-bottom: 0.7rem !important;
        background: transparent !important;
    }
    td {
        padding-bottom: 0.5rem !important;
        background: transparent !important;
    }


    .reszletek_Row{
        max-height: 0;
        opacity: 0;
        transition: max-height 0.4s ease-out, opacity 0.4s ease-out;
    }
    .reszletek_Row.active{
        max-height: 10000px;
        opacity: 1;
        
    }

    .csoves_Tbl_Div{
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: max-height 0.4s ease-out, opacity 0.4s ease-out;
    }
    .csoves_Tbl_Div.active{
        max-height: 10000px;
        opacity: 1;
        overflow-x: auto;
        overflow-y: hidden;
    }
    #csoves_Tbl{
        max-height: 10000px;
        opacity: 1;
        transition: max-height 0.4s ease-out, opacity 0.4s ease-out;
    }
    #csoves_Tbl.elrejt{
        max-height: 0;
        opacity: 0;
    }
    #csoves_Tbl.teljesenElrejt{
        display: none;
    }

    .modern_Tbl_Div{
        max-height: 10000px;
        opacity: 1;
        overflow: hidden;
        transition: max-height 0.4s ease-out, opacity 0.4s ease-out;
    }
    .modern_Tbl_Div.inactive{
        max-height: 0;
        opacity: 0;
    }
    .modern_Tbl_Div.teljesenElrejt{
        display: none;
    }

    th, td{
        white-space: nowrap;        
    }   

    .reszleted_Td{
        display: none;
        
    }
    .reszleted_Td.active{
        display: table-cell;
        text-align: center;
    }

    .reszletek_Lbl{
        font-weight: bold;
    }

    .lbl_Input {
        gap: 0.5rem;
    }
    .lbl_Input_Valaszto{
        margin-bottom: 0.25rem;
    }

    .menusor{
        display:flex;
        justify-content: center;
        gap: 1rem;
        padding: 1rem 0.5rem;
        background: rgba(255,255,255,0.5);
        backdrop-filter: blur(4px);
        border-bottom-right-radius: 12px;
        border-bottom-left-radius: 12px;
    }
    .menusor .btn{
        flex: none;
        width: auto;
    }

    #bttn_mdrn{
        display: none;
    }
    #bttn_mdrn.active{
        display: inline-block;
    }

    #bttn_tbl.inactive{
        display: none;
    }

    
    #szurok_Nagy_div {
        width: 100%;
    }

    #bttn_szurok {
        width: fit-content;
        padding: 0.5rem 2rem;
    }

    #szurok_kis_div{
        width: 100%;
        background: white;
        opacity: 0;
        max-height: 0;
        pointer-events: none;
        padding: 0;
        border-radius: 10px;
        transition: opacity 0.5s ease-in-out, max-height 0.5s ease-in-out;
    }
    #szurok_kis_div.elohiv{
        opacity: 1;
        max-height: 10000px;
        padding: 2rem 25%;
        pointer-events: auto;
    }
    #szurok_kis_div.teljesenElrejt {
        display: none;
    }

</style>



<div class="py-4">
    <a asp-page="/FelhOldalak/Fomenu" class="btn bttn_Tovabb mb-3">vissza</a>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    @if(TempData["SikerUzenet"] is string siker)
    {
        <div class="alert alert-success alert-dismissible show fade">
            @siker
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card egyCard animatedDiv mb-2">
        <div class="card-header cardTeto">
            <span class="blckBrwn_Grdnt_Font">Alkalmazottak listája</span>
            <div>
                <button type="button" id="kicsinyit" class="btn"></button>
                <button type="button" id="nagyit" class="btn"></button>
            </div>
        </div>
        <div class="cardKozep card-body">
            
            <div class="modern_Tbl_Div">
                <table id="modern_Tbl" class="table table-borderless">
                    <thead>
                        <tr>
                            <th class="text-center">Név</th>
                            <th class="text-center">Telefon</th>
                            <th class="text-center">Részletek</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Felhasznalok_Lst.Count < 1)
                        {
                            <tr>
                                <th>Nincsenek elmentett felhasználók.</th>
                            </tr>
                        }
                        else
                        {
                            @foreach (var ember in Model.Felhasznalok_Lst)
                            {
                                if (ember.Email != "kerberosz@gmail.com")
                                {
                                    <tr>
                                        <td class="col-5 col-md-2 text-center align-middle">
                                            <span class="brwn_Grdnt_Font">@ember.Nev</span>
                                        </td>
                                        <td class="col-5 col-md-2 text-center align-middle">
                                            <a class="teloLink" href="tel:+35@(ember.Tel_Korzet)@(ember.PhoneNumber)">+36 @ember.Tel_Korzet @ember.PhoneNumber</a>
                                        </td>
                                        <td class="col-2 col-md-2 text-center align-middle">
                                            <span class="forgoNyil brwn_Grdnt_Font fs-2">➤</span>
                                        </td>
                                    </tr>

                                    <tr class="reszletek_Row">
                                        <td colspan="3" class="reszleted_Td" style="margin-top:-10px;">
                                            <div class="small d-flex flex-column align-items-center mb-5">
                                                <div class="lbl_Input">
                                                    <span class="reszletek_Lbl">E-mail:</span>
                                                    <span class="reszletek_Txt">@ember.Email</span>
                                                </div>
                                                <div class="lbl_Input lbl_Input_Valaszto">
                                                    <span class="reszletek_Lbl">Lakcím:</span>
                                                    <span class="reszletek_Txt">@ember.Lakcim</span>
                                                </div>

                                                <div class="lbl_Input">
                                                    <span class="reszletek_Lbl">Születési idő:</span>
                                                    <span class="reszletek_Txt">@ember.SzulIdo</span>
                                                </div>
                                                <div class="lbl_Input">
                                                    <span class="reszletek_Lbl">Születési hely:</span>
                                                    <span class="reszletek_Txt">@ember.SzulHely</span>
                                                </div>
                                                <div class="lbl_Input lbl_Input_Valaszto">
                                                    <span class="reszletek_Lbl">Anyja neve:</span>
                                                    <span class="reszletek_Txt">@ember.AnyjaNeve</span>
                                                </div>

                                                <div class="lbl_Input">
                                                    <span class="reszletek_Lbl">Személyi azonosító:</span>
                                                    <span class="reszletek_Txt">@ember.SzemelyiSzam</span>
                                                </div>
                                                <div class="lbl_Input">
                                                    <span class="reszletek_Lbl">Lakcímkártya száma:</span>
                                                    <span class="reszletek_Txt">@ember.LakcimK_Szama</span>
                                                </div>
                                                <div class="lbl_Input">
                                                    <span class="reszletek_Lbl">Adószám:</span>
                                                    <span class="reszletek_Txt">@ember.Adoszam</span>
                                                </div>
                                                <div class="lbl_Input">
                                                    <span class="reszletek_Lbl">Tajszám:</span>
                                                    <span class="reszletek_Txt">@ember.Tajszam</span>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(ember.ProfKepUtovnal))
                                                {
                                                    <div class="d-flex flex-column gap-1 lbl_Input_Valaszto">
                                                        <span class="reszletek_Lbl">Profilkép:</span>
                                                        <img src="@ember.ProfKepUtovnal" alt="@ember.Nev" class="rounded-circle mb-1 mx-auto" style="height: 80px; width: 80px; object-fit:cover; border:solid 0.5px #7a4f35;" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="lbl_Input lbl_Input_Valaszto">
                                                        <span class="reszletek_Lbl">Profilkép:</span>
                                                        <span>nincs elmentett kép</span>
                                                    </div>

                                                }

                                                @if (!string.IsNullOrWhiteSpace(ember.JogsiSzama))
                                                {
                                                    <div class="lbl_Input">
                                                        <span class="reszletek_Lbl">Jogosítvány száma:</span>
                                                        <span class="reszletek_Txt">@(string.IsNullOrWhiteSpace(ember.JogsiSzama) ? "-" : ember.JogsiSzama)</span>
                                                    </div>
                                                    <div class="lbl_Input">
                                                        <span class="reszletek_Lbl">Legmagasabb kategória:</span>
                                                        <span class="reszletek_Txt">@(string.IsNullOrWhiteSpace(ember.JogsiKateg) ? "-" : ember.JogsiKateg)</span>
                                                    </div>
                                                    <div class="lbl_Input">
                                                        <span class="reszletek_Lbl">Rendszám:</span>
                                                        <span class="reszletek_Txt">@(string.IsNullOrWhiteSpace(ember.Rendszam) ? "-" : ember.Rendszam)</span>
                                                    </div>
                                                    <div class="lbl_Input mb-3">
                                                        <span class="reszletek_Lbl">Férhőhelyek száma:</span>
                                                        <span class="reszletek_Txt">@(string.IsNullOrWhiteSpace(ember.Ferohely) ? "-" : ember.Ferohely)</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="lbl_Input mb-3">
                                                        <span class="reszletek_Lbl">Jogosítvány:</span>
                                                        <span class="reszletek_Txt">nem áll rendelkezésre</span>
                                                    </div>
                                                }


                                                <form method="post" asp-page-handler="Torles" onsubmit="return confirm('Biztosan törli a felhasználót?');">
                                                    <input type="hidden" name="id" value="@ember.Id" />
                                                    <button type="submit" class="bttn_Trls btn btn-sm btn-danger">törlés</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="csoves_Tbl_Div flex-column gap-4">

                <div id="szurok_Nagy_div" class="d-flex flex-column justify-content-center align-items-center gap-3">
                    <button type="button" id="bttn_szurok" class="btn bttn_Action">szűrők</button>
                    <div id="szurok_kis_div" class="d-flex gap-5">

                        <div id="gyors_Szurok" class="d-flex flex-column gap-3 me-3">
                            <label class="form-label fw-bold">Gyors szűrők</label>

                            <div class="d-flex flex-column gap-1">
                                <div class="form-check">
                                    <input class="form-check-input n_oszlopSzuro" type="checkbox" id="n_szuro_MindIgen" checked />
                                    <label class="form-check-label" for="n_szuro_MindIgen">Mind kiválaszt</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input n_oszlopSzuro" type="checkbox" id="n_szuro_MindNem"/>
                                    <label class="form-check-label" for="n_szuro_MindNem">Mind töröl</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input n_oszlopSzuro" type="checkbox" id="n_szuro_NevEmailTel"/>
                                    <label class="form-check-label" for="n_szuro_NevEmailTel">Név, e-mail, telefon</label>
                                </div>
                            </div>
                        </div>

                        <div id="reszletes_Szurok" class="d-flex flex-column gap-3">


                            <label class="form-label fw-bold">Részletes szűrők</label>

                            <div class="d-flex flex-column gap-1">
                                <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_nev" data-column="0" checked />
                                <label class="form-check-label" for="szuro_nev">Név</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_email" data-column="1" checked />
                                <label class="form-check-label" for="szuro_email">E-mail</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_tel" data-column="2" checked />
                                <label class="form-check-label" for="szuro_tel">Telefon</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_lakcim" data-column="3" checked />
                                <label class="form-check-label" for="szuro_lakcim">Lakcím</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_szulIdo" data-column="4" checked />
                                <label class="form-check-label" for="szuro_szulIdo">Születési idő</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_szulHely" data-column="5" checked />
                                <label class="form-check-label" for="szuro_szulHely">Születési hely</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_anyja" data-column="6" checked />
                                <label class="form-check-label" for="szuro_anyja">Anyja neve</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_szemelyi" data-column="7" checked />
                                <label class="form-check-label" for="szuro_szemelyi">Személyi azonosító</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_lakKartyaSzama" data-column="8" checked />
                                <label class="form-check-label" for="szuro_lakKartyaSzama">Lakcímkártya száma</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_adoszam" data-column="9" checked />
                                <label class="form-check-label" for="szuro_adoszam">Adószám</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_taj" data-column="10" checked />
                                <label class="form-check-label" for="szuro_taj">Tajszám</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_jogsiSzam" data-column="11" checked />
                                <label class="form-check-label" for="szuro_jogsiSzam">Jogosítvány száma</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_jogsiKateg" data-column="12" checked />
                                <label class="form-check-label" for="szuro_jogsiKateg">Legmagasabb kategória</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_rendszam" data-column="13" checked />
                                <label class="form-check-label" for="szuro_rendszam">Rendszám</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input oszlopSzuro" type="checkbox" id="szuro_ferohely" data-column="14" checked />
                                <label class="form-check-label" for="szuro_ferohely">Férőhelyek száma</label>
                            </div>
                            </div>

                        </div>
                        
                    </div>
                </div>

                <table id="csoves_Tbl" class="table">
                    <thead>
                        <tr>
                            <th class="text-center">Név</th>
                            <th class="text-center">E-mail</th>
                            <th class="text-center">Telefon</th>
                            <th class="text-center">Lakcím</th>
                            <th class="text-center">Születési idő</th>
                            <th class="text-center">Születési hely</th>
                            <th class="text-center">Anyja neve</th>
                            <th class="text-center">Személyi azonosító</th>
                            <th class="text-center">Lakcímkártya száma</th>
                            <th class="text-center">Adószám</th>
                            <th class="text-center">Tajszám</th>
                            <th class="text-center">Jogosítvány száma</th>
                            <th class="text-center">Legmagasabb kategória</th>
                            <th class="text-center">Rendszám</th>
                            <th class="text-center">Férhőhelyek száma</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ember in Model.Felhasznalok_Lst)
                        {
                            if (ember.Email != "kerberosz@gmail.com")
                            {
                                <tr>
                                <td>@ember.Nev</td>
                                <td>@ember.Email</td>
                                <td>@ember.Tel_Korzet @ember.PhoneNumber</td>
                                <td>@ember.Lakcim</td>
                                <td>@ember.SzulIdo</td>
                                <td>@ember.SzulHely</td>
                                <td>@ember.AnyjaNeve</td>
                                <td>@ember.SzemelyiSzam</td>
                                <td>@ember.LakcimK_Szama</td>
                                <td>@ember.Adoszam</td>
                                <td>@ember.Tajszam</td>
                                <td>@(string.IsNullOrWhiteSpace(ember.JogsiSzama) ? "-" : ember.JogsiSzama)</td>
                                <td>@ember.JogsiKateg</td>
                                <td>@ember.Rendszam</td>
                                <td>@ember.Ferohely</td>
                            </tr>
                            }                            
                        }
                    </tbody>
                </table>
            </div>
            
        </div>
    </div>

    <div class="menusor">
        <button id="bttn_mdrn" class="btn bttn_Action">Modern megjelenítés</button>        
        <button id="bttn_tbl" class="btn bttn_Action">Táblázatos megjelenítés</button>        
        @*<button id="bttn_tovabb" class="btn bttn_Action">Továbbítás ➤</button>*@
    </div>
</div>
@section Scripts{
    <script>
        document.addEventListener('DOMContentLoaded',function(){
            const bttn_mdrn = document.getElementById('bttn_mdrn');
            const bttn_tbl = document.getElementById('bttn_tbl');
            const bttn_szurok = document.getElementById('bttn_szurok');
            const szurok_kis_div = document.getElementById('szurok_kis_div');
            const csoves_Tbl = document.getElementById('csoves_Tbl');
            const csoves_Tbl_Div = document.querySelector('.csoves_Tbl_Div');
            const modern_Tbl_Div = document.querySelector('.modern_Tbl_Div');
            const modern_Tbl = document.getElementById('modern_Tbl');

            const n_szuro_MindIgen = document.getElementById('n_szuro_MindIgen');
            const n_szuro_MindNem = document.getElementById('n_szuro_MindNem');
            const n_szuro_NevEmailTel = document.getElementById('n_szuro_NevEmailTel');


            document.querySelector('.animatedDiv')?.classList.add('elohiv');

            bttn_tbl.addEventListener('click',function(){

                modern_Tbl_Div.classList.add('inactive');
                setTimeout(function(){
                    modern_Tbl_Div.classList.add('teljesenElrejt');
                }, 400);

                csoves_Tbl_Div.classList.add('active');                

                bttn_mdrn.classList.add('active');
                bttn_tbl.classList.add('inactive');

            });

            bttn_mdrn.addEventListener('click',function(){
                csoves_Tbl_Div.classList.remove('active');

                modern_Tbl_Div.classList.remove('teljesenElrejt');
                requestAnimationFrame(function(){
                    modern_Tbl_Div.classList.remove('inactive');
                    });  

                bttn_mdrn.classList.remove('active');
                bttn_tbl.classList.remove('inactive');

            });



            document.querySelectorAll('.forgoNyil').forEach( function(nyil) {
                nyil.addEventListener('click', function(){
                    const fo_Row = nyil.closest('tr');
                    const reszl_Row = fo_Row.nextElementSibling;

                    if (!reszl_Row || !reszl_Row.classList.contains('reszletek_Row')) return;

                    const reszl_Td = reszl_Row.querySelector('.reszleted_Td');

                    document.querySelectorAll('.reszletek_Row.active').forEach( function(sor){
                        if(sor !== reszl_Row){
                            sor.classList.remove('active');
                            const masikTd = sor.querySelector('.reszleted_Td');
                            masikTd.classList.remove('active');
                            const masikNyil = sor.previousElementSibling?.querySelector('.forgoNyil');
                            masikNyil?.classList.remove('srehen');
                        }
                    });

                    reszl_Row.classList.toggle('active');
                    reszl_Td.classList.toggle('active');
                    nyil.classList.toggle('srehen');
                });
            });

            bttn_szurok.addEventListener('click',function(){

                bttn_szurok.blur();

                if(!csoves_Tbl.classList.contains('elrejt'))
                {
                    csoves_Tbl_Div.style.overflow='hidden';
                    csoves_Tbl.classList.add('elrejt');

                    szurok_kis_div.classList.remove('teljesenElrejt');
                    requestAnimationFrame(function(){
                        szurok_kis_div.classList.add('elohiv');
                    });

                    bttn_szurok.textContent='szűrők elrejtése';
                    setTimeout(function(){
                        csoves_Tbl.classList.add('teljesenElrejt');
                    }, 400);
                }
                else /* Table FELFEDÉSE */
                {
                    csoves_Tbl_Div.style.overflow='hidden';
                    csoves_Tbl.classList.remove('teljesenElrejt');
                    requestAnimationFrame(function(){
                        csoves_Tbl.classList.remove('elrejt');
                    });                    
                    szurok_kis_div.classList.remove('elohiv');
                    setTimeout(function(){
                        szurok_kis_div.classList.add('teljesenElrejt');
                        csoves_Tbl_Div.style.overflowX = 'auto';
                        csoves_Tbl_Div.style.overflowY = 'hidden';
                    }, 500);
                    bttn_szurok.textContent='szűrők';

                }               
                
            });

            document.querySelectorAll('.oszlopSzuro').forEach(function(checkbox){
                checkbox.addEventListener('change',function(){
                
                    const oszlop = Number(checkbox.dataset.column) +1;
                    document.querySelectorAll(`#csoves_Tbl tr > *:nth-child(${oszlop})`
                        ).forEach(function(cella){
                            cella.style.display=checkbox.checked ? '' : 'none';
                        });
                });
            });

            n_szuro_MindIgen.addEventListener('change',function(){
                if(n_szuro_MindIgen.checked)
                {
                    document.querySelectorAll('.oszlopSzuro').forEach(function(checkbox){
                        checkbox.checked=true;
                        checkbox.dispatchEvent(new Event('change'));
                    });
                    n_szuro_MindNem.checked=false;
                    n_szuro_NevEmailTel.checked=false;
                }
            });

            n_szuro_MindNem.addEventListener('change',function(){
                if(n_szuro_MindNem.checked)
                {
                    document.querySelectorAll('.oszlopSzuro').forEach(function(checkbox){
                        checkbox.checked=false;
                        checkbox.dispatchEvent(new Event('change'));
                    });
                    n_szuro_MindIgen.checked=false;
                    n_szuro_NevEmailTel.checked=false;
                }
            });

            n_szuro_NevEmailTel.addEventListener('change',function(){
                if(n_szuro_NevEmailTel.checked)
                {
                    document.querySelectorAll('.oszlopSzuro').forEach(function(checkbox){
                        const oszlop= Number(checkbox.dataset.column);
                        checkbox.checked=oszlop<=2;
                        checkbox.dispatchEvent(new Event('change'));
                    });
                    n_szuro_MindIgen.checked=false;
                    n_szuro_MindNem.checked=false;
                }
            });

        });
    </script>
}